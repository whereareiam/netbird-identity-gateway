diff --git a/shared/signal/client/registration_test.go b/shared/signal/client/registration_test.go
new file mode 100644
index 0000000..8c6e88f
--- /dev/null
+++ b/shared/signal/client/registration_test.go
@@ -0,0 +1,116 @@
+package client
+
+import (
+	"context"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	sigProto "github.com/netbirdio/netbird/shared/signal/proto"
+	"github.com/stretchr/testify/require"
+	"golang.zx2c4.com/wireguard/wgctrl/wgtypes"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/metadata"
+)
+
+type registrationTestServer struct {
+	sigProto.UnimplementedSignalExchangeServer
+	sendHeader bool
+}
+
+func (s *registrationTestServer) ConnectStream(stream sigProto.SignalExchange_ConnectStreamServer) error {
+	if s.sendHeader {
+		if err := stream.SendHeader(metadata.Pairs(sigProto.HeaderRegistered, "1")); err != nil {
+			return err
+		}
+	}
+	<-stream.Context().Done()
+	return stream.Context().Err()
+}
+
+func TestRegistrationTimeout(t *testing.T) {
+	for _, registered := range []bool{false, true} {
+		name := "stalled"
+		if registered {
+			name = "registered"
+		}
+		t.Run(name, func(t *testing.T) {
+			lis, err := net.Listen("tcp", "127.0.0.1:0")
+			require.NoError(t, err)
+			srv := grpc.NewServer()
+			sigProto.RegisterSignalExchangeServer(srv, &registrationTestServer{sendHeader: registered})
+			go srv.Serve(lis)
+			defer srv.Stop()
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			key, err := wgtypes.GenerateKey()
+			require.NoError(t, err)
+			c, err := NewClient(ctx, lis.Addr().String(), key, false)
+			require.NoError(t, err)
+			defer c.Close()
+			require.Eventually(t, c.Ready, time.Second, time.Millisecond)
+			require.False(t, c.IsHealthy(), "transport readiness must not imply registration")
+			started := time.Now()
+			stream, err := c.connect(ctx, key.PublicKey().String(), cancel, 100*time.Millisecond)
+			if !registered {
+				require.Error(t, err)
+				require.Less(t, time.Since(started), time.Second)
+				require.False(t, c.IsHealthy())
+				return
+			}
+			require.NoError(t, err)
+			c.notifyStreamConnected()
+			require.True(t, c.IsHealthy())
+			select {
+			case <-stream.Context().Done():
+				t.Fatal("registration timeout canceled an established stream")
+			case <-time.After(250 * time.Millisecond):
+			}
+		})
+	}
+}
+
+// A canceled registration attempt must not cancel the parent's Receive loop.
+func TestRegistrationReconnect(t *testing.T) {
+	lis, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	srv := grpc.NewServer()
+	backend := &reconnectingRegistrationServer{}
+	sigProto.RegisterSignalExchangeServer(srv, backend)
+	go srv.Serve(lis)
+	defer srv.Stop()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	key, err := wgtypes.GenerateKey()
+	require.NoError(t, err)
+	c, err := NewClient(ctx, lis.Addr().String(), key, false)
+	require.NoError(t, err)
+	defer c.Close()
+	done := make(chan error, 1)
+	go func() { done <- c.Receive(ctx, func(*sigProto.Message) error { return nil }) }()
+	require.Eventually(t, func() bool { return c.streamRegistered.Load() }, 25*time.Second, 20*time.Millisecond)
+	require.GreaterOrEqual(t, backend.calls.Load(), int32(2))
+	require.NoError(t, ctx.Err())
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("Receive did not stop after parent cancellation")
+	}
+}
+
+type reconnectingRegistrationServer struct {
+	sigProto.UnimplementedSignalExchangeServer
+	calls atomic.Int32
+}
+
+func (s *reconnectingRegistrationServer) ConnectStream(stream sigProto.SignalExchange_ConnectStreamServer) error {
+	if s.calls.Add(1) > 1 {
+		if err := stream.SendHeader(metadata.Pairs(sigProto.HeaderRegistered, "1")); err != nil {
+			return err
+		}
+	}
+	<-stream.Context().Done()
+	return stream.Context().Err()
+}
